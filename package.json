{
  "name": "@cypherx/chat-ui",
  "version": "0.9.0",
  "description": "CypherX client renderer: streaming chat UI + Agentic UI (KPI cards, charts, tables) over the CypherX-native ViewSpec protocol. Themeable, session-aware, backend-agnostic.",
  "type": "module",
  "publishConfig": {
    "access": "restricted"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./markdown.css": "./dist/markdown.css",
    "./browser": {
      "types": "./dist/browser/widget.d.ts",
      "import": "./dist/browser/widget.mjs"
    }
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "INTEGRATION.md",
    "THEMING.md",
    "BROWSER_SDK.md"
  ],
  "scripts": {
    "build": "tsup",
    "postbuild": "node scripts/build-styles.mjs && node scripts/build-browser.mjs",
    "package:browser": "node scripts/package-browser.mjs",
    "check:contract": "node scripts/check-aui-contract.mjs",
    "test": "vitest run && npm run check:contract",
    "test:watch": "vitest",
    "test:layout": "playwright test",
    "test:browser": "npm run package:browser && playwright test --config playwright.browser.config.ts",
    "prepublishOnly": "npm run lint && npm run build && npm test",
    "dev": "tsup --watch",
    "harness": "vite --config harness/vite.config.ts",
    "lint": "tsc --noEmit && tsc --project tsconfig.layout.json",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/cli": "4.3.3",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.19.21",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "jsdom": "^28.1.0",
    "postcss": "^8.5.0",
    "postcss-selector-parser": "7.1.0",
    "postcss-value-parser": "4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vite": "8.3.4",
    "vitest": "^3.2.6"
  },
  "dependencies": {
    "clsx": "^2.1.0",
    "eventsource-parser": "3.0.6",
    "lucide-react": ">=0.400.0",
    "motion": "^12.0.0",
    "recharts": "^3.7.0",
    "tailwind-merge": "^3.0.0"
  },
  "keywords": [
    "react",
    "chat",
    "ui",
    "components",
    "streaming",
    "sse",
    "ai",
    "chat-ui"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Trionic-Core/chat-ui-component-library.git"
  }
}
