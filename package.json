{
  "name": "@cypherx/chat-ui",
  "version": "0.8.0",
  "description": "CypherX client renderer: streaming chat UI + Agentic UI (KPI cards, charts, tables) over the CypherX-native ViewSpec protocol. Themeable, session-aware, backend-agnostic.",
  "type": "module",
  "publishConfig": {
    "access": "restricted"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "INTEGRATION.md",
    "THEMING.md"
  ],
  "scripts": {
    "build": "tsup",
    "postbuild": "npx @tailwindcss/cli -i src/styles/globals.css -o dist/styles.css",
    "check:contract": "node scripts/check-aui-contract.mjs",
    "test": "vitest run && npm run check:contract",
    "test:watch": "vitest",
    "prepublishOnly": "npm test && npm run lint && npm run build",
    "dev": "tsup --watch",
    "harness": "vite --config harness/vite.config.ts",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.19.21",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^28.1.0",
    "postcss": "^8.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.3",
    "vitest": "^3.2.6"
  },
  "dependencies": {
    "clsx": "^2.1.0",
    "lucide-react": ">=0.400.0",
    "motion": "^12.0.0",
    "recharts": "^3.7.0",
    "tailwind-merge": "^3.0.0"
  },
  "keywords": [
    "react",
    "chat",
    "ui",
    "components",
    "streaming",
    "sse",
    "ai",
    "chat-ui"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Trionic-Core/chat-ui-component-library.git"
  }
}
